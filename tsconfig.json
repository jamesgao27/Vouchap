{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["./vouchap-app/src/shared-logic/*"],
      "@/components/*": ["./vouchap-app/src/mobile-ui/components/*"],
      "@/types": ["./vouchap-app/src/shared-logic/types/index.ts"],
      "@/types/*": ["./vouchap-app/src/shared-logic/types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
